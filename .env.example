# .env.example — copy to .env.local for local dev, or set these in your host's
# environment-variable dashboard for production. Values below are placeholders.

# ── Surgeon annotation pipeline (PDF overlay) ────────────────────────────────
# Required for pages/api/page-annotation-plan.ts — SurgeonAnnotationPlan is the
# SOLE source of automatic PDF annotations, with no fallback tier. Missing/
# invalid: the overlay shows a truthful "Advanced annotations could not be
# generated." notice with Retry, never a substitute lesser tier of highlights.
OPENAI_API_KEY=

# ── Chief Resident (Reader + NoteLab, pages/api/chief-resident-teaching.ts) ──
# Required — without it, chief-resident-status.ts reports unavailable and the
# teaching endpoint returns a clean error (no silent hang).
OPENAI_API_KEY=
# Optional — model override for Chief Resident specifically. Defaults to gpt-4o.
OPENAI_CHIEF_RESIDENT_MODEL=

# ── DAT Apex Chief Resident (components/apex/*, pages/api/chief-resident.ts) ─
# A SEPARATE feature from Reader/NoteLab Chief Resident above (same persona
# name, different implementation — non-streaming, no page grounding). Required
# only if DAT Apex is used.
ANTHROPIC_API_KEY=

# ── Whiteboard / tldraw canvas ────────────────────────────────────────────────
# Client-bundled (NEXT_PUBLIC_ prefix — baked in at build time, visible in the
# browser bundle by design; this is tldraw's own license-key model, not a
# secret). Required in production builds: TldrawCanvas.tsx renders a visible
# "Whiteboard configuration is unavailable." error (not a blank canvas) when
# NODE_ENV=production and this is missing. NOT required in development — the
# gate only trips in production so local dev works without a license.
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# ── Firebase (auth + storage) ─────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional — run against local Firebase emulators instead of production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=

# ── Other AI-backed features (optional — only needed if that feature is used) ─
# Gemini (pages/api/gemini-visual.ts) describes figures/diagrams/charts/tables
# on the current page and merges into the ONE SurgeonAnnotationPlan read
# (page-annotation-plan.ts) as additional context — it never independently
# proposes highlights or a Whiteboard lesson. Missing key: this step is
# skipped entirely, text-only analysis proceeds exactly as before.
GEMINI_API_KEY=
# Optional — model override. Defaults to gemini-2.0-flash.
GEMINI_MODEL=
COHERE_API_KEY=
YOUTUBE_API_KEY=
IDEOGRAM_API_KEY=
SDXL_API_KEY=
SDXL_API_ENDPOINT=
SDXL_MODEL_ID=
SDXL_FINE_TUNED_ENDPOINT=
SDXL_FINE_TUNED_MODEL_ID=
SDXL_ALLOWED_ENDPOINTS=

# ── App-level toggles (optional) ──────────────────────────────────────────────
APP_PREVIEW_PASSWORD=
NEXT_PUBLIC_DISABLE_GOOGLE_SIGNIN=
NEXT_PUBLIC_ALLOW_CLIENT_OPENAI=
NEXT_PUBLIC_ELENA_MODE_ENABLED=
NEXT_PUBLIC_DEBUG_READER=
NEXT_PUBLIC_WHITEBOARD_DEBUG=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_API_BASE=
