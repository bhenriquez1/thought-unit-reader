{
  "name": "surgeon-view-pdrm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run setup:pdf-worker",
    "build": "next build",
    "prebuild": "npm run setup:pdf-worker",
    "start": "next start -p $PORT",
    "start:local": "next start -p 3000",
    "export": "next build && next export",
    "clean": "rimraf .next",
    "clean:full": "rimraf .next node_modules/.cache",
    "dev:clean": "npm run clean && next dev",
    "type-check": "tsc --noEmit",
    "render-build": "if [ -f package-lock.json ]; then npm ci; else npm install; fi && npm run build",
    "setup:pdf-worker": "node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync('public',{recursive:true});const cand=['node_modules/pdfjs-dist/build/pdf.worker.min.mjs','node_modules/pdfjs-dist/build/pdf.worker.min.js','node_modules/pdfjs-dist/build/pdf.worker.js'];const src=cand.find(f=>fs.existsSync(f));if(!src){console.error('❌ pdf.worker not found in pdfjs-dist');process.exit(1);}const dest=p.join('public','pdf.worker.min.mjs');fs.copyFileSync(src,dest);console.log('✅ pdf.worker copied from',src,'→',dest);\"",
    "postinstall": "npm run setup:pdf-worker"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@heroicons/react": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@react-pdf-viewer/core": "^3.12.0",
    "ai": "^5.0.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^10.8.0",
    "framer-motion": "^12.23.12",
    "idb-keyval": "^6.2.2",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.532.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.48.0",
    "next": "^14.2.5",
    "next-themes": "^0.4.6",
    "openai": "^5.12.0",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^7.7.2",
    "react-tooltip": "^5.29.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/react-dropzone": "^5.1.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "jest": "^29.7.0",
    "postcss": "^8.4.35",
    "rimraf": "^5.0.5",
    "tailwind-scrollbar": "^2.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
