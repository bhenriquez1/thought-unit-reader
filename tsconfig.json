{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    
    // Added options to handle PDF.js TypeScript issues
    "noImplicitAny": false,       // Prevents errors with implicit any types
    "suppressImplicitAnyIndexErrors": true,  // Helps with index access
    "ignoreDeprecations": "5.0"   // Ignores certain deprecation warnings
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "pdfjs.d.ts"          // Make sure to include our custom type definitions
  ],
  "exclude": [
    "node_modules"
  ]
}